# ModelEval Arena - Konfiguracja środowiska

# Port serwera API (domyślnie 3001)
PORT=3001

# Klucz API do OpenRouter.ai (lub innego dostawcy zgodnego z OpenAI API)
# Klucz możesz podać tutaj lub bezpośrednio w interfejsie aplikacji (w panelu Ustawienia ⚙️).
# Zarejestruj się i pobierz klucz na: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Base URL API (domyślnie OpenRouter):
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI:     https://api.openai.com/v1
# - Groq:       https://api.groq.com/openai/v1
# - DeepSeek:   https://api.deepseek.com/v1
# - Ollama:     http://localhost:11434/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Domyślne modele używane w Arenie (drabinka: free vs budżetowy)
DEFAULT_MODEL_A=google/gemma-4-31b-it:free
DEFAULT_MODEL_B=openai/gpt-4o-mini

# Model sędziego LLM (uniwersalny test / auto-ocena rubryką)
DEFAULT_JUDGE_MODEL=google/gemini-2.5-flash
