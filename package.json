{
  "name": "modeleval-arena",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w modeleval-server\" \"npm run dev -w modeleval-client\"",
    "dev:web": "npm run dev -w modeleval-client",
    "dev:api": "npm run dev -w modeleval-server",
    "build": "npm run build -w modeleval-client",
    "db:reset": "npm run db:reset -w modeleval-server",
    "start:api": "npm run start -w modeleval-server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
